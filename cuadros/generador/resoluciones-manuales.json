  "Ecuaciones": {
   "$-4+2(5+3x)=6-5(x-2)$": "$\\begin{aligned} -4+2(5+3x) &= 6-5(x-2) \\\\ -4+10+6x &= 6-5x+10 \\\\ 6x+5x &= 6+10+4-10 \\\\ 11x &= 10 \\\\ x &= \\frac{10}{11} \\\\ \\mathbf{x} &\\mathbf{= \\tfrac{10}{11}} \\end{aligned}$",
   "$8x-5(x-3)=3(4x+2)-7$": "$\\begin{aligned} 8x-5(x-3) &= 3(4x+2)-7 \\\\ 8x-5x+15 &= 12x+6-7 \\\\ 8x-5x-12x &= 6-7-15 \\\\ -9x &= -16 \\\\ x &= \\frac{-16}{-9} \\\\ \\mathbf{x} &\\mathbf{= \\tfrac{16}{9}} \\end{aligned}$",
   "$3(-4x+5)+8=9x-2(1+7x)$": "$\\begin{aligned} 3(-4x+5)+8 &= 9x-2(1+7x) \\\\ -12x+15+8 &= 9x-2-14x \\\\ -12x-9x+14x &= -2-15-8 \\\\ -7x &= -25 \\\\ x &= \\frac{-25}{-7} \\\\ \\mathbf{x} &\\mathbf{= \\tfrac{25}{7}} \\end{aligned}$",
   "$-4(-3x-2)+9=5x+2(7-6x)$": "$\\begin{aligned} -4(-3x-2)+9 &= 5x+2(7-6x) \\\\ 12x+8+9 &= 5x+14-12x \\\\ 12x-5x+12x &= 14-8-9 \\\\ 19x &= -3 \\\\ x &= \\frac{-3}{19} \\\\ \\mathbf{x} &\\mathbf{= -\\tfrac{3}{19}} \\end{aligned}$",
   "$7x-3(x-2)=4(3x+1)-9$": "$\\begin{aligned} 7x-3(x-2) &= 4(3x+1)-9 \\\\ 7x-3x+6 &= 12x+4-9 \\\\ 7x-3x-12x &= 4-9-6 \\\\ -8x &= -11 \\\\ x &= \\frac{-11}{-8} \\\\ \\mathbf{x} &\\mathbf{= \\tfrac{11}{8}} \\end{aligned}$",
   "$9-2(4x-5)=-3+6(2x+3)$": "$\\begin{aligned} 9-2(4x-5) &= -3+6(2x+3) \\\\ 9-8x+10 &= -3+12x+18 \\\\ -8x-12x &= -3+18-9-10 \\\\ -20x &= -4 \\\\ x &= \\frac{-4}{-20} \\\\ \\mathbf{x} &\\mathbf{= \\tfrac{1}{5}} \\end{aligned}$",
   "$-2(-5x-4)+7=8x+3(6-4x)$": "$\\begin{aligned} -2(-5x-4)+7 &= 8x+3(6-4x) \\\\ 10x+8+7 &= 8x+18-12x \\\\ 10x-8x+12x &= 18-8-7 \\\\ 14x &= 3 \\\\ x &= \\frac{3}{14} \\\\ \\mathbf{x} &\\mathbf{= \\tfrac{3}{14}} \\end{aligned}$",
   "$4(x+6)-5=7x-3(2-4x)$": "$\\begin{aligned} 4(x+6)-5 &= 7x-3(2-4x) \\\\ 4x+24-5 &= 7x-6+12x \\\\ 4x-7x-12x &= -6-24+5 \\\\ -15x &= -25 \\\\ x &= \\frac{-25}{-15} \\\\ \\mathbf{x} &\\mathbf{= \\tfrac{5}{3}} \\end{aligned}$",
   "$8-4(2x-3)=-5+3(6x+1)$": "$\\begin{aligned} 8-4(2x-3) &= -5+3(6x+1) \\\\ 8-8x+12 &= -5+18x+3 \\\\ -8x-18x &= -5+3-8-12 \\\\ -26x &= -22 \\\\ x &= \\frac{-22}{-26} \\\\ \\mathbf{x} &\\mathbf{= \\tfrac{11}{13}} \\end{aligned}$",
   "$-6+5(2+4x)=8-2(x-7)$": "$\\begin{aligned} -6+5(2+4x) &= 8-2(x-7) \\\\ -6+10+20x &= 8-2x+14 \\\\ 20x+2x &= 8+14+6-10 \\\\ 22x &= 18 \\\\ x &= \\frac{18}{22} \\\\ \\mathbf{x} &\\mathbf{= \\tfrac{9}{11}} \\end{aligned}$",
   "$5(x+3)-7=2x-4(3-2x)$": "$\\begin{aligned} 5(x+3)-7 &= 2x-4(3-2x) \\\\ 5x+15-7 &= 2x-12+8x \\\\ 5x-2x-8x &= -12-15+7 \\\\ -5x &= -20 \\\\ x &= \\frac{-20}{-5} \\\\ \\mathbf{x} &\\mathbf{= 4} \\end{aligned}$",
   "$2(-3x+8)+4=5x-6(2+3x)$": "$\\begin{aligned} 2(-3x+8)+4 &= 5x-6(2+3x) \\\\ -6x+16+4 &= 5x-12-18x \\\\ -6x-5x+18x &= -12-16-4 \\\\ 7x &= -32 \\\\ x &= \\frac{-32}{7} \\\\ \\mathbf{x} &\\mathbf{= -\\tfrac{32}{7}} \\end{aligned}$"
  },
  "Expresiones algebraicas": {
   "$2[(x+5)(3-2x)+4x]-3=$": "$\\begin{aligned} 2[(x+5)(3-2x)+4x]-3 &= \\\\ 2[3x-2x^2+15-10x+4x]-3 &= \\\\ 6x-4x^2+30-20x+8x-3 &= \\\\ \\mathbf{-4x^2-6x+27} & \\end{aligned}$",
