  "Gráfica con tabulación": {
   "$6x-3y=12$": "$\\begin{aligned} -3y &= 12 - 6x \\\\ y &= \\dfrac{12 - 6x}{-3} \\\\ \\mathbf{y} &= \\mathbf{-4 + 2x} \\\\ &(-2,-8), (-1,-6), (0,-4), (1,-2), (2,0) \\end{aligned}$",
   "$-12x-3y=6$": "$\\begin{aligned} -3y &= 6 + 12x \\\\ y &= \\dfrac{6 + 12x}{-3} \\\\ \\mathbf{y} &= \\mathbf{-2 - 4x} \\\\ &(-2,6), (-1,2), (0,-2), (1,-6), (2,-10) \\end{aligned}$",
   "$-3x+y=-5$": "$\\begin{aligned} y &= -5 + 3x \\\\ \\mathbf{y} &= \\mathbf{-5 + 3x} \\\\ &(-2,-11), (-1,-8), (0,-5), (1,-2), (2,1) \\end{aligned}$",
   "$3x+y=9$": "$\\begin{aligned} y &= 9 - 3x \\\\ \\mathbf{y} &= \\mathbf{9 - 3x} \\\\ &(-2,15), (-1,12), (0,9), (1,6), (2,3) \\end{aligned}$",
   "$4x-y=8$": "$\\begin{aligned} -y &= 8 - 4x \\\\ \\mathbf{y} &= \\mathbf{-8 + 4x} \\\\ &(-2,-16), (-1,-12), (0,-8), (1,-4), (2,0) \\end{aligned}$",
   "$10x+5y=20$": "$\\begin{aligned} 5y &= 20 - 10x \\\\ y &= \\dfrac{20 - 10x}{5} \\\\ \\mathbf{y} &= \\mathbf{4 - 2x} \\\\ &(-2,8), (-1,6), (0,4), (1,2), (2,0) \\end{aligned}$"
