   "$5[(-x+3)(2-4x)+2x]-1=$": "$\\begin{aligned} 5[(-x+3)(2-4x)+2x]-1 &= \\\\ 5[-2x+4x^2+6-12x+2x]-1 &= \\\\ -10x+20x^2+30-60x+10x-1 &= \\\\ \\mathbf{20x^2-60x+29} & \\end{aligned}$",
   "$2(-4x+3)^2+5(2x-1)-7=$": "$\\begin{aligned} 2(-4x+3)^2+5(2x-1)-7 &= \\\\ 2(-4x+3)(-4x+3)+10x-5-7 &= \\\\ 2(16x^2-12x-12x+9)+10x-5-7 &= \\\\ 2(16x^2-24x+9)+10x-5-7 &= \\\\ 32x^2-48x+18+10x-5-7 &= \\\\ \\mathbf{32x^2-38x+6} & \\end{aligned}$",
   "$2[(4x-1)(2-3x)+5x]-6=$": "$\\begin{aligned} 2[(4x-1)(2-3x)+5x]-6 &= \\\\ 2[8x-12x^2-2+3x+5x]-6 &= \\\\ 16x-24x^2-4+6x+10x-6 &= \\\\ \\mathbf{-24x^2+32x-10} & \\end{aligned}$",
   "$2(x-4)^2+3(2x+5)-7=$": "$\\begin{aligned} 2(x-4)^2+3(2x+5)-7 &= \\\\ 2(x-4)(x-4)+6x+15-7 &= \\\\ 2(x^2-4x-4x+16)+6x+15-7 &= \\\\ 2(x^2-8x+16)+6x+15-7 &= \\\\ 2x^2-16x+32+6x+15-7 &= \\\\ \\mathbf{2x^2-10x+40} & \\end{aligned}$",
   "$5[(2x-4)(3-x)+2x]-1=$": "$\\begin{aligned} 5[(2x-4)(3-x)+2x]-1 &= \\\\ 5[6x-2x^2-12+4x+2x]-1 &= \\\\ 30x-10x^2-60+20x+10x-1 &= \\\\ \\mathbf{-10x^2+60x-61} & \\end{aligned}$",
   "$4(3x-1)^2+2(2-5x)-5=$": "$\\begin{aligned} 4(3x-1)^2+2(2-5x)-5 &= \\\\ 4(3x-1)(3x-1)+4-10x-5 &= \\\\ 4(9x^2-3x-3x+1)+4-10x-5 &= \\\\ 4(9x^2-6x+1)+4-10x-5 &= \\\\ 36x^2-24x+4+4-10x-5 &= \\\\ \\mathbf{36x^2-34x+3} & \\end{aligned}$",
   "$3[(2x+3)(4-x)+5x]-2=$": "$\\begin{aligned} 3[(2x+3)(4-x)+5x]-2 &= \\\\ 3[8x-2x^2+12-3x+5x]-2 &= \\\\ 24x-6x^2+36-9x+15x-2 &= \\\\ \\mathbf{-6x^2+30x+34} & \\end{aligned}$",
   "$3(2x+5)^2-4(3-x)+2=$": "$\\begin{aligned} 3(2x+5)^2-4(3-x)+2 &= \\\\ 3(2x+5)(2x+5)-12+4x+2 &= \\\\ 3(4x^2+10x+10x+25)-12+4x+2 &= \\\\ 3(4x^2+20x+25)-12+4x+2 &= \\\\ 12x^2+60x+75-12+4x+2 &= \\\\ \\mathbf{12x^2+64x+65} & \\end{aligned}$",
   "$4[(-3x+1)(5-2x)+3x]+1=$": "$\\begin{aligned} 4[(-3x+1)(5-2x)+3x]+1 &= \\\\ 4[-15x+6x^2+5-2x+3x]+1 &= \\\\ -60x+24x^2+20-8x+12x+1 &= \\\\ \\mathbf{24x^2-56x+21} & \\end{aligned}$",
   "$4(-x+2)^2+5(-3+4x)-6=$": "$\\begin{aligned} 4(-x+2)^2+5(-3+4x)-6 &= \\\\ 4(-x+2)(-x+2)-15+20x-6 &= \\\\ 4(x^2-2x-2x+4)-15+20x-6 &= \\\\ 4(x^2-4x+4)-15+20x-6 &= \\\\ 4x^2-16x+16-15+20x-6 &= \\\\ \\mathbf{4x^2+4x-5} & \\end{aligned}$"
