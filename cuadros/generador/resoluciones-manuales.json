  "Jerarquía de operaciones": {
   "$7+5(3)(-6)-4(8-5)+9(2)^2=$": "$\\begin{aligned} 7+5(3)(-6)-4(8-5)+9(2)^2 &= \\\\ 7-90-4(3)+9(4) &= \\\\ 7-90-12+36 &= \\\\ 43-102 &= \\mathbf{-59} \\end{aligned}$",
   "$-4[-5(-3(-2+8))]=$": "$\\begin{aligned} -4[-5(-3(-2+8))] &= \\\\ -4[-5(-3(6))] &= \\\\ -4[-5(-18)] &= \\\\ -4[90] &= \\mathbf{-360} \\end{aligned}$",
   "$-6(5)(-4)+7(2-6)-8+3(4)^2=$": "$\\begin{aligned} -6(5)(-4)+7(2-6)-8+3(4)^2 &= \\\\ 120+7(-4)-8+3(16) &= \\\\ 120-28-8+48 &= \\\\ 168-36 &= \\mathbf{132} \\end{aligned}$",
   "$7[-3(4(5+1))]=$": "$\\begin{aligned} 7[-3(4(5+1))] &= \\\\ 7[-3(4(6))] &= \\\\ 7[-3(24)] &= \\\\ 7[-72] &= \\mathbf{-504} \\end{aligned}$",
   "$-4(-3)(-2)-3(-2+6)+5-4(-3)^2=$": "$\\begin{aligned} -4(-3)(-2)-3(-2+6)+5-4(-3)^2 &= \\\\ -24-3(4)+5-4(9) &= \\\\ -24-12+5-36 &= \\\\ -72+5 &= \\mathbf{-67} \\end{aligned}$",
   "$-6[5(-2(3-7))]=$": "$\\begin{aligned} -6[5(-2(3-7))] &= \\\\ -6[5(-2(-4))] &= \\\\ -6[5(8)] &= \\\\ -6[40] &= \\mathbf{-240} \\end{aligned}$",
   "$6(2)(-5)+7(8-4)-3+5(2)^3=$": "$\\begin{aligned} 6(2)(-5)+7(8-4)-3+5(2)^3 &= \\\\ -60+7(4)-3+5(8) &= \\\\ -60+28-3+40 &= \\\\ -63+68 &= \\mathbf{5} \\end{aligned}$",
   "$8[-6(2(4+3))]=$": "$\\begin{aligned} 8[-6(2(4+3))] &= \\\\ 8[-6(2(7))] &= \\\\ 8[-6(14)] &= \\\\ 8[-84] &= \\mathbf{-672} \\end{aligned}$",
   "$4-3(5)(-2)+6(-9+7)-7(-4)^2=$": "$\\begin{aligned} 4-3(5)(-2)+6(-9+7)-7(-4)^2 &= \\\\ 4+30+6(-2)-7(16) &= \\\\ 4+30-12-112 &= \\\\ 34-124 &= \\mathbf{-90} \\end{aligned}$",
   "$-5[3(-7(6-2))]=$": "$\\begin{aligned} -5[3(-7(6-2))] &= \\\\ -5[3(-7(4))] &= \\\\ -5[3(-28)] &= \\\\ -5[-84] &= \\mathbf{420} \\end{aligned}$",
   "$-5(4)(3)+6(2-9)-2+8(5)^3=$": "$\\begin{aligned} -5(4)(3)+6(2-9)-2+8(5)^3 &= \\\\ -60+6(-7)-2+8(125) &= \\\\ -60-42-2+1000 &= \\\\ -104+1000 &= \\mathbf{896} \\end{aligned}$",
