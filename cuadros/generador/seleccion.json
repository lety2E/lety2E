 {
  "titulo": "Problemas de ecuaciones",
  "archivo": "problemas-ecuaciones.html",
  "receta": [
   "ejercicios",
   1,
   2
  ],
  "versiones": [
   [
    {
     "tex": "Un número más veinte es igual a cuarenta.",
     "origen": "respuesta"
    },
    {
     "tex": "Siete veces un número más tres es igual a veinticuatro.",
     "origen": "extra"
    },
    {
     "tex": "El doble de la suma de un número más tres es igual a doce.",
     "origen": "extra"
    }
   ],
   [
    {
     "tex": "El quíntuple de un número menos diez es igual a quince.",
     "origen": "extra"
    },
    {
     "tex": "El triple de un número es igual a cuarenta y cinco.",
     "origen": "respuesta"
    },
    {
     "tex": "La suma de tres números consecutivos es igual a quince.",
     "origen": "extra"
    }
   ],
   [
    {
     "tex": "La diferencia de un número y ocho por tres es igual a nueve.",
     "origen": "extra"
    },
    {
     "tex": "El cuádruple de un número es igual al mismo número más doce.",
     "origen": "extra"
    },
    {
     "tex": "El cuadrado de un número es igual a cien.",
     "origen": "respuesta"
    }
   ],
   [
    {
     "tex": "Dos más el triple de un número es igual a veintitrés.",
     "origen": "respuesta"
    },
    {
     "tex": "El cuádruple de un número menos seis es igual a dieciocho.",
     "origen": "extra"
    },
    {
     "tex": "La mitad de un número aumentada en ocho es igual a doce.",
     "origen": "extra"
    }
   ],
   [
    {
     "tex": "Un número disminuido en siete es igual a ocho.",
     "origen": "extra"
    },
    {
     "tex": "Un tercio de un número menos uno es igual a cinco.",
     "origen": "respuesta"
    },
    {
     "tex": "El triple de un número aumentado en su mitad es veinte.",
     "origen": "extra"
    }
   ],
   [
    {
     "tex": "Cinco veces la diferencia de un número y dos es igual a veinte.",
     "origen": "extra"
    },
    {
     "tex": "El cuadrado de un número aumentado en siete es igual a dieciséis.",
     "origen": "extra"
    },
    {
     "tex": "El triple de un número menos ocho es igual a diez.",
     "origen": "respuesta"
    }
   ]
  ],
